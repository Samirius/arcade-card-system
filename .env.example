# Arcade Management System — Environment Variables
# Copy this file to .env and fill in real values.

# REQUIRED: Secret key for JWT signing (min 32 characters)
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

# REQUIRED: PostgreSQL password (used by both the postgres and backend services)
POSTGRES_PASSWORD=change-this-to-a-strong-random-password

# Environment: development | staging | production
ENVIRONMENT=production
DEBUG=false

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
